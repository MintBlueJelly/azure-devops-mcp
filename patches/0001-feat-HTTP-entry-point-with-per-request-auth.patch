@@ -0,0 +1,98 @@
+#!/usr/bin/env node
+
+// Copyright (c) Microsoft Corporation.
+// Licensed under the MIT License.
+
+import yargs from "yargs";
+
+import { createHttpServer } from "./http-server.js";
+import { logger } from "./logger.js";
+import { setOrgName } from "./organization.js";
+import { ALL_DOMAINS, Domain, DomainsManager } from "./shared/domains.js";
+import { getCliArgs } from "./utils.js";
+import { packageVersion } from "./version.js";
+
+// A container runner's arguments follow the image's own, so an option given twice takes its last value instead of
+// becoming an array.
+function lastValue<T>(value: T | T[]): T {
+  return Array.isArray(value) ? value[value.length - 1] : value;
+}
+
+const argv = yargs(getCliArgs())
+  .scriptName("mcp-server-azuredevops-http")
+  .usage("Usage: $0 <organization> [options]")
+  .version(packageVersion)
+  .command("$0 <organization> [options]", "Azure DevOps MCP Server over Streamable HTTP, acting as the caller whose bearer token each request carries", (yargs) => {
+    yargs.positional("organization", {
+      describe: "Azure DevOps organization name",
+      type: "string",
+      demandOption: true,
+    });
+  })
+  .option("domains", {
+    alias: "d",
+    describe: "Domain(s) to enable: 'all' for everything, or specific domains like 'repositories builds work'. Defaults to 'all'.",
+    type: "string",
+    array: true,
+    default: "all",
+  })
+  .option("host", {
+    describe: "Address to listen on",
+    type: "string",
+    default: "127.0.0.1",
+    coerce: (host: string | string[]) => lastValue(host),
+  })
+  .option("port", {
+    alias: "p",
+    describe: "Port to listen on",
+    type: "number",
+    default: 8080,
+    coerce: (port: number | number[]) => lastValue(port),
+  })
+  .option("path", {
+    describe: "Path of the MCP endpoint",
+    type: "string",
+    default: "/mcp",
+    coerce: (path: string | string[]) => {
+      const value = lastValue(path);
+      return value.startsWith("/") ? value : `/${value}`;
+    },
+  })
+  // Upstream enables every domain, write tools included, when one is misspelled. Refuse to start instead.
+  .check(({ domains }) => {
+    const known = new Set<string>([ALL_DOMAINS, ...Object.values(Domain)]);
+    const unknown = [domains].flat().filter((domain) => !known.has(String(domain).trim().toLowerCase()));
+    if (unknown.length > 0) {
+      throw new Error(`Unknown domain(s): ${unknown.join(", ")}. Available: ${Object.values(Domain).join(", ")}`);
+    }
+    return true;
+  })
+  .help()
+  .parseSync();
+
+const organization = argv.organization as string;
+setOrgName(organization);
+const enabledDomains = new DomainsManager(argv.domains).getEnabledDomains();
+
+const server = createHttpServer({ organization, enabledDomains, path: argv.path });
+
+server.listen(argv.port, argv.host, () => {
+  logger.info("Azure DevOps MCP Server listening over Streamable HTTP", {
+    organization,
+    host: argv.host,
+    port: argv.port,
+    path: argv.path,
+    enabledDomains: Array.from(enabledDomains),
+    version: packageVersion,
+  });
+});
+
+for (const signal of ["SIGINT", "SIGTERM"] as const) {
+  process.on(signal, () => {
+    logger.info(`Received ${signal}, closing HTTP server`);
+    server.close(() => process.exit(0));
+    // close() closes only the connections that are idle right now. Close the others as their requests finish; the
+    // server answers any further request on them with Connection: close.
+    setInterval(() => server.closeIdleConnections(), 100).unref();
+  });
+}
