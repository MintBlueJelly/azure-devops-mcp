diff --git a/test/src/http-server.test.ts b/test/src/http-server.test.ts
new file mode 100644
index 0000000..8ea5c8a
--- /dev/null
+++ b/test/src/http-server.test.ts
@@ -0,0 +1,120 @@
+// Copyright (c) Microsoft Corporation.
+// Licensed under the MIT License.
+
+import { Server } from "http";
+import { AddressInfo } from "net";
+import { createHttpServer } from "../../src/http-server";
+import { setOrgName } from "../../src/organization";
+import { Domain } from "../../src/shared/domains";
+
+describe("Streamable HTTP server", () => {
+  const realFetch = global.fetch;
+  let server: Server;
+  let baseUrl: string;
+  let searchAuthorizations: string[];
+
+  beforeAll(async () => {
+    setOrgName("test-org");
+    server = createHttpServer({ organization: "test-org", enabledDomains: new Set([Domain.SEARCH]) });
+    await new Promise<void>((resolve) => server.listen(0, "127.0.0.1", resolve));
+    baseUrl = `http://127.0.0.1:${(server.address() as AddressInfo).port}`;
+  });
+
+  afterAll(async () => {
+    await new Promise((resolve) => server.close(resolve));
+  });
+
+  beforeEach(() => {
+    searchAuthorizations = [];
+    // Stands in for Azure DevOps Search: echoes back the Authorization header it was called with. Requests to the
+    // server under test go through untouched.
+    global.fetch = jest.fn(async (input: string | URL | Request, init?: RequestInit) => {
+      const url = input instanceof Request ? input.url : input.toString();
+      if (!url.startsWith("https://almsearch.dev.azure.com/")) {
+        return realFetch(input, init);
+      }
+      const authorization = new Headers(init?.headers).get("Authorization") ?? "";
+      searchAuthorizations.push(authorization);
+      await new Promise((resolve) => setTimeout(resolve, 25)); // keep concurrent tool calls in flight together
+      return new Response(JSON.stringify({ count: 0, results: [], seenAuthorization: authorization }), { status: 200 });
+    }) as typeof fetch;
+  });
+
+  afterEach(() => {
+    global.fetch = realFetch;
+  });
+
+  function post(body: unknown, token?: string): Promise<Response> {
+    return realFetch(`${baseUrl}/mcp`, {
+      method: "POST",
+      headers: {
+        "Content-Type": "application/json",
+        "Accept": "application/json, text/event-stream",
+        ...(token ? { Authorization: `Bearer ${token}` } : {}),
+      },
+      body: JSON.stringify(body),
+    });
+  }
+
+  function searchWiki(id: number) {
+    return { jsonrpc: "2.0", id, method: "tools/call", params: { name: "search_wiki", arguments: { searchText: "release notes" } } };
+  }
+
+  it("rejects a request without a bearer token before any tool runs", async () => {
+    const response = await post(searchWiki(1));
+
+    expect(response.status).toBe(401);
+    expect(response.headers.get("WWW-Authenticate")).toBe("Bearer");
+    expect(searchAuthorizations).toHaveLength(0);
+  });
+
+  it("rejects a malformed Authorization header", async () => {
+    const response = await realFetch(`${baseUrl}/mcp`, {
+      method: "POST",
+      headers: { "Content-Type": "application/json", "Accept": "application/json, text/event-stream", "Authorization": "Basic dXNlcjpwYXNz" },
+      body: JSON.stringify(searchWiki(1)),
+    });
+
+    expect(response.status).toBe(401);
+    expect(searchAuthorizations).toHaveLength(0);
+  });
+
+  it("allows only POST on the MCP endpoint", async () => {
+    const response = await realFetch(`${baseUrl}/mcp`, { method: "GET", headers: { Authorization: "Bearer token-a" } });
+
+    expect(response.status).toBe(405);
+    expect(response.headers.get("Allow")).toBe("POST");
+  });
+
+  it("answers health checks without a token", async () => {
+    const response = await realFetch(`${baseUrl}/healthz`);
+
+    expect(response.status).toBe(200);
+    expect(await response.text()).toBe("ok");
+  });
+
+  it("initializes without issuing a session id", async () => {
+    const response = await post({ jsonrpc: "2.0", id: 1, method: "initialize", params: { protocolVersion: "2025-11-25", capabilities: {}, clientInfo: { name: "jest", version: "0" } } }, "token-a");
+    const body = await response.json();
+
+    expect(response.status).toBe(200);
+    expect(response.headers.get("mcp-session-id")).toBeNull();
+    expect(body.result.serverInfo.name).toBe("Azure DevOps MCP Server");
+    expect(body.result.protocolVersion).toBe("2025-11-25");
+  });
+
+  it("calls Azure DevOps with each request's own token, even when requests overlap", async () => {
+    const tokens = ["token-a", "token-b", "token-c", "token-d"];
+
+    const bodies = await Promise.all(tokens.map((token, index) => post(searchWiki(index), token).then((response) => response.json())));
+
+    bodies.forEach((body, index) => {
+      const text: string = body.result.content[0].text;
+      expect(text).toContain(`Bearer ${tokens[index]}`);
+      for (const other of tokens.filter((token) => token !== tokens[index])) {
+        expect(text).not.toContain(other);
+      }
+    });
+    expect([...searchAuthorizations].sort()).toEqual(tokens.map((token) => `Bearer ${token}`).sort());
+  });
+});
