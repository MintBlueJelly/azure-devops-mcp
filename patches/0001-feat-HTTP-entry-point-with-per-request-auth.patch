diff --git a/src/http-server.ts b/src/http-server.ts
new file mode 100644
index 0000000..999ce8b
--- /dev/null
+++ b/src/http-server.ts
@@ -0,0 +1,165 @@
+// Copyright (c) Microsoft Corporation.
+// Licensed under the MIT License.
+
+import { createServer, IncomingMessage, Server, ServerResponse } from "http";
+import { McpServer } from "@modelcontextprotocol/sdk/server/mcp.js";
+import { StreamableHTTPServerTransport } from "@modelcontextprotocol/sdk/server/streamableHttp.js";
+import { getBearerHandler, WebApi } from "azure-devops-node-api";
+
+import { logger } from "./logger.js";
+import { configureAllTools } from "./tools.js";
+import { UserAgentComposer } from "./useragent.js";
+import { packageVersion } from "./version.js";
+
+interface HttpServerOptions {
+  organization: string;
+  enabledDomains: Set<string>;
+  path?: string;
+}
+
+// MCP requests are small JSON-RPC messages. The SDK would buffer a body of any size, so this bounds what one request
+// can make the server hold in memory.
+const maxRequestBodyBytes = 4 * 1024 * 1024;
+
+/**
+ * Creates a stateless Streamable HTTP server for running behind a gateway that authenticates each caller.
+ *
+ * The server holds no credential of its own. Every request must carry the caller's Microsoft Entra access token
+ * for Azure DevOps as a bearer token, and each request gets a fresh MCP server whose token and connection providers
+ * return that token and nothing else. Nothing is shared between requests, so one caller's token is never used for
+ * another caller's tool call.
+ */
+function createHttpServer(options: HttpServerOptions): Server {
+  const orgUrl = "https://dev.azure.com/" + options.organization;
+  const mcpPath = options.path ?? "/mcp";
+
+  const server = createServer((req, res) => {
+    // close() stops new connections but keeps serving the ones still open, such as a gateway's pooled connection.
+    // Closing each of those after its response lets shutdown finish.
+    if (!server.listening) {
+      res.setHeader("Connection", "close");
+    }
+    handleRequest(req, res, orgUrl, mcpPath, options.enabledDomains).catch((error) => {
+      logger.error("Failed to handle HTTP request:", error);
+      if (!res.headersSent) {
+        sendJsonRpcError(res, 500, -32603, "Internal server error");
+      }
+    });
+  });
+  return server;
+}
+
+async function handleRequest(req: IncomingMessage, res: ServerResponse, orgUrl: string, mcpPath: string, enabledDomains: Set<string>): Promise<void> {
+  const { pathname } = new URL(req.url ?? "/", "http://localhost");
+
+  if (pathname === "/healthz") {
+    res.writeHead(200, { "Content-Type": "text/plain" }).end("ok");
+    return;
+  }
+
+  if (pathname !== mcpPath) {
+    sendJsonRpcError(res, 404, -32000, "Not found");
+    return;
+  }
+
+  // Stateless: there is no session to open a GET stream on or to end with DELETE.
+  if (req.method !== "POST") {
+    res.setHeader("Allow", "POST");
+    sendJsonRpcError(res, 405, -32000, "Method not allowed");
+    return;
+  }
+
+  const accessToken = getBearerToken(req);
+  if (!accessToken) {
+    res.setHeader("WWW-Authenticate", "Bearer");
+    sendJsonRpcError(res, 401, -32001, "Unauthorized: a bearer token for Azure DevOps is required");
+    return;
+  }
+
+  const body = await readBody(req, maxRequestBodyBytes);
+  if (body === undefined) {
+    // The rest of the body is never read, so the connection cannot carry another request.
+    res.setHeader("Connection", "close");
+    sendJsonRpcError(res, 413, -32000, "Request body too large");
+    return;
+  }
+
+  let message: unknown;
+  try {
+    message = JSON.parse(body.toString("utf8"));
+  } catch {
+    sendJsonRpcError(res, 400, -32700, "Parse error: Invalid JSON");
+    return;
+  }
+
+  const server = createMcpServer(orgUrl, accessToken, enabledDomains);
+  // JSON responses: a stateless server cannot send requests back to the client, so there is nothing to stream.
+  const transport = new StreamableHTTPServerTransport({ sessionIdGenerator: undefined, enableJsonResponse: true });
+  res.on("close", () => {
+    void transport.close();
+    void server.close();
+  });
+
+  await server.connect(transport);
+  await transport.handleRequest(req, res, message);
+}
+
+/**
+ * Reads the request body, or resolves to undefined as soon as it is known to exceed the limit.
+ */
+function readBody(req: IncomingMessage, limit: number): Promise<Buffer | undefined> {
+  return new Promise((resolve, reject) => {
+    if (Number(req.headers["content-length"]) > limit) {
+      resolve(undefined);
+      return;
+    }
+    const chunks: Buffer[] = [];
+    let size = 0;
+    req.on("data", (chunk: Buffer) => {
+      size += chunk.length;
+      if (size > limit) {
+        req.pause();
+        resolve(undefined);
+      } else {
+        chunks.push(chunk);
+      }
+    });
+    req.on("end", () => resolve(Buffer.concat(chunks)));
+    req.on("error", reject);
+  });
+}
+
+function createMcpServer(orgUrl: string, accessToken: string, enabledDomains: Set<string>): McpServer {
+  const server = new McpServer({
+    name: "Azure DevOps MCP Server",
+    version: packageVersion,
+    icons: [
+      {
+        src: "https://cdn.vsassets.io/content/icons/favicon.ico",
+      },
+    ],
+  });
+
+  const userAgentComposer = new UserAgentComposer(packageVersion);
+  const tokenProvider = async () => accessToken;
+  const connectionProvider = async () =>
+    new WebApi(orgUrl, getBearerHandler(accessToken), undefined, {
+      productName: "AzureDevOps.MCP",
+      productVersion: packageVersion,
+      userAgent: userAgentComposer.userAgent,
+    });
+
+  configureAllTools(server, tokenProvider, connectionProvider, () => userAgentComposer.userAgent, enabledDomains);
+  return server;
+}
+
+function getBearerToken(req: IncomingMessage): string | undefined {
+  const match = /^Bearer\s+(\S+)\s*$/i.exec(req.headers.authorization ?? "");
+  return match?.[1];
+}
+
+function sendJsonRpcError(res: ServerResponse, status: number, code: number, message: string): void {
+  res.writeHead(status, { "Content-Type": "application/json" }).end(JSON.stringify({ jsonrpc: "2.0", error: { code, message }, id: null }));
+}
+
+export { createHttpServer, HttpServerOptions };
